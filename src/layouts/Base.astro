---
import BaseHead from '../components/BaseHead.astro';
import { GITHUB_URL, SITE_TITLE } from '../consts';

interface Props {
	title: string;
	description: string;
	type?: 'website' | 'article';
	/** 홈 화면: 메뉴, 푸터 없이 화면 전체를 씀 */
	home?: boolean;
}

const { title, description, type, home = false } = Astro.props;
const path = Astro.url.pathname;
const current = (prefix: string) => (path.startsWith(prefix) ? 'page' : undefined);
const isHome = path === '/' ? 'page' : undefined;
---

<html lang="ko">
	<head>
		<BaseHead title={title} description={description} type={type} home={home} />
	</head>
	<body class:list={{ 'is-home': home }}>
		<header class="site-header">
			<nav>
				<a href="/" aria-current={isHome}>Home</a>
				<a href="/blog/" aria-current={current('/blog/')}>Categories</a>
				<a href="/tags/" aria-current={current('/tags/')}>Tags</a>
				<a href="/search/" aria-current={current('/search/')}>Search</a>
				<a href="/about/" aria-current={current('/about')}>About</a>
				<a href="/rss.xml">RSS</a>
			</nav>
		</header>
		<main>
			<slot />
		</main>
		<footer class="site-footer">
			<span>© {new Date().getFullYear()} {SITE_TITLE}</span>
			<a href={GITHUB_URL}>GitHub</a>
		</footer>
	</body>
</html>
