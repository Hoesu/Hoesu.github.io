---
// 홈 화면 최근 글 위젯 (2×2): 가장 최근 글의 카테고리, 제목, 날짜. 누르면 그 글로 감
import { categoryApp } from '../../utils/apps';
import { getCategory, type Post } from '../../utils/posts';
import FormattedDate from '../FormattedDate.astro';
import MiniIcon from '../MiniIcon.astro';

interface Props {
	post: Post;
}

const { post } = Astro.props;
const category = getCategory(post);
const app = category ? categoryApp(category) : undefined;
---

<a class="widget recent" href={`/blog/${post.id}/`} aria-label={`최근 글: ${post.data.title}`}>
	<span class="top">
		{app && <MiniIcon app={app} size={22} />}
		<span class="kicker">최근 글</span>
	</span>
	<span class="title">{post.data.title}</span>
	<FormattedDate date={post.data.pubDate} />
</a>

<style>
	.recent {
		display: flex;
		flex-direction: column;
		gap: 6px;
		color: #fff;
		text-decoration: none;
		-webkit-tap-highlight-color: transparent;
		transition: transform 0.15s ease;
	}
	.recent:hover {
		text-decoration: none;
	}
	.recent:active {
		transform: scale(0.96);
	}
	.recent:focus-visible {
		outline: 2px solid #fff;
		outline-offset: 3px;
	}
	.top {
		display: flex;
		align-items: center;
		gap: 7px;
	}
	.kicker {
		color: rgb(255 255 255 / 0.7);
		font-size: 12px;
	}
	.title {
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 3;
		overflow: hidden;
		margin-top: 2px;
		font-size: 15px;
		font-weight: 700;
		line-height: 1.3;
		word-break: keep-all;
	}
	.recent :global(time) {
		margin-top: auto;
		color: rgb(255 255 255 / 0.7);
		font-size: 12px;
		font-variant-numeric: tabular-nums;
	}
</style>
