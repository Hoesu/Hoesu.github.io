---
import '../styles/global.css';
import { GOATCOUNTER_CODE, SITE_TITLE } from '../consts';

interface Props {
	title: string;
	description: string;
	type?: 'website' | 'article';
}

const { title, description, type = 'website' } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const fullTitle = title === SITE_TITLE ? title : `${title} | ${SITE_TITLE}`;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<!-- 상시 다크: 스크롤바/폼 등 브라우저 기본 UI도 다크로, 모바일 주소창 색도 배경에 맞춤 -->
<meta name="color-scheme" content="dark" />
<meta name="theme-color" content="#0f1115" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={new URL('rss.xml', Astro.site)} />
<link rel="canonical" href={canonicalURL} />

<title>{fullTitle}</title>
<meta name="description" content={description} />

<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:site_name" content={SITE_TITLE} />

<!-- 방문 통계: 배포 빌드에서만, 코드가 설정돼 있을 때만. localhost 방문은 GoatCounter가 알아서 무시함 -->
{
	import.meta.env.PROD && GOATCOUNTER_CODE && (
		<script
			is:inline
			async
			data-goatcounter={`https://${GOATCOUNTER_CODE}.goatcounter.com/count`}
			src="https://gc.zgo.at/count.js"
		/>
	)
}
