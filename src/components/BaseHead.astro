---
import '../styles/global.css';
import headTransition from '../scripts/head-transition.inline.js?raw';
import { inlineJs } from '../utils/inline-js';
import { GOATCOUNTER_CODE, SITE_TITLE, SITE_VERIFICATION } from '../consts';

interface Props {
	title: string;
	description: string;
	type?: 'website' | 'article';
	home?: boolean;
	/** 링크 공유 미리보기 이미지 주소 (글은 /og/<글 id>.png). 없으면 사이트 공통 이미지 */
	image?: string;
}

const { title, description, type = 'website', home = false, image = '/og/default.png' } = Astro.props;
const imageURL = new URL(image, Astro.site);
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const fullTitle = title === SITE_TITLE ? title : `${title} | ${SITE_TITLE}`;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
{/* 상시 다크: 스크롤바/폼 등 브라우저 기본 UI도 다크로, 모바일 주소창 색도 배경에 맞춤 */}
<meta name="color-scheme" content="dark" />
<meta name="theme-color" content="#0b0f2b" />

{/* 홈 화면 앱 열기 / 닫기 전환. 첫 화면이 그려지기 전에 등록돼야 해서 <head> 인라인 스크립트 (설명은 파일 안에) */}
<script is:inline set:html={inlineJs(headTransition)}></script>
{/* 홈: 아이콘이 다 그려진 뒤에 전환 화면을 찍도록 (닫기 애니메이션 대상) */}
{home && <link rel="expect" href="#home-dock" blocking="render" />}
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={new URL('rss.xml', Astro.site)} />
<link rel="canonical" href={canonicalURL} />
{/* 검색엔진 소유 확인: 홈 화면에만 있으면 됨 (src/consts.ts 의 SITE_VERIFICATION) */}
{home && SITE_VERIFICATION.google && <meta name="google-site-verification" content={SITE_VERIFICATION.google} />}
{home && SITE_VERIFICATION.naver && <meta name="naver-site-verification" content={SITE_VERIFICATION.naver} />}

<title>{fullTitle}</title>
<meta name="description" content={description} />

<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:site_name" content={SITE_TITLE} />
{/* 링크 공유 미리보기 이미지 (빌드할 때 만듦: src/utils/og.ts) */}
<meta property="og:image" content={imageURL} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={fullTitle} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content={imageURL} />

{/* 방문 통계: 배포 빌드에서만, 코드가 설정돼 있을 때만. localhost 방문은 GoatCounter가 알아서 무시함 */}
{
	import.meta.env.PROD && GOATCOUNTER_CODE && (
		<script
			is:inline
			async
			data-goatcounter={`https://${GOATCOUNTER_CODE}.goatcounter.com/count`}
			src="https://gc.zgo.at/count.js"
		/>
	)
}
