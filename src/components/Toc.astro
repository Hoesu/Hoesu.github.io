---
import type { MarkdownHeading } from 'astro';

interface Props {
	headings: MarkdownHeading[];
}

// ## 와 ### 만 목차에 넣음
const items = Astro.props.headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
	items.length >= 2 && (
		<nav class="toc" aria-label="목차">
			<details>
				<summary>목차</summary>
				<ul>
					{items.map((h) => (
						<li class={`depth-${h.depth}`}>
							<a href={`#${h.slug}`}>{h.text}</a>
						</li>
					))}
				</ul>
			</details>
		</nav>
	)
}

<script>
	// 넓은 화면: 항상 펼쳐서 오른쪽에 고정 / 좁은 화면: 접힌 상태로 글 상단에
	const wide = window.matchMedia('(min-width: 1200px)');
	const details = document.querySelector<HTMLDetailsElement>('.toc details');
	if (details) {
		const sync = () => (details.open = wide.matches);
		sync();
		wide.addEventListener('change', sync);
	}

	// 지금 읽고 있는 섹션 강조
	//  - 스크롤 이벤트가 아무리 많이 와도 한 프레임에 한 번만 계산 (requestAnimationFrame)
	//  - 강조할 항목이 바뀔 때만 class 를 바꿈 (안 바뀌면 화면을 다시 그릴 일 없음)
	//  - 목차가 접혀 있으면(좁은 화면) 계산 안 함. 펼칠 때 한 번 계산
	const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc a')];
	const pairs = links
		.map((a) => ({ a, el: document.getElementById(decodeURIComponent(a.hash.slice(1))) }))
		.filter((p): p is { a: HTMLAnchorElement; el: HTMLElement } => !!p.el);
	let current = -1;
	let queued = false;
	const update = () => {
		queued = false;
		if (details && !details.open) return;
		// 화면 위 120px 를 지난 마지막 소제목. 아래쪽 소제목부터 보다가 찾으면 멈춤
		let next = 0;
		for (let i = pairs.length - 1; i >= 0; i--) {
			if (pairs[i].el.getBoundingClientRect().top < 120) {
				next = i;
				break;
			}
		}
		if (next === current) return;
		pairs[current]?.a.classList.remove('active');
		pairs[next].a.classList.add('active');
		current = next;
	};
	const request = () => {
		if (!queued) {
			queued = true;
			requestAnimationFrame(update);
		}
	};
	if (pairs.length) {
		update();
		window.addEventListener('scroll', request, { passive: true });
		details?.addEventListener('toggle', request);
	}
</script>

<style>
	.toc {
		margin: 0 0 2.5em;
		font-size: 0.875rem;
		line-height: 1.5;
	}
	summary {
		cursor: pointer;
		color: var(--muted);
		user-select: none;
	}
	ul {
		list-style: none;
		margin: 0.6em 0 0;
		padding: 0.2em 0 0.2em 0.9em;
		border-left: 1px solid var(--border);
	}
	li {
		margin: 0.3em 0;
	}
	li.depth-3 {
		padding-left: 0.9em;
	}
	a {
		color: var(--muted);
	}
	a:hover,
	a.active {
		color: var(--text);
		text-decoration: none;
	}

	/* 넓은 화면: 본문(680px) 오른쪽 빈 공간에 고정 */
	@media (min-width: 1200px) {
		.toc {
			position: fixed;
			top: 120px;
			left: calc(50% + 370px);
			width: 220px;
			max-height: calc(100vh - 160px);
			overflow-y: auto;
			margin: 0;
		}
		summary {
			display: none;
		}
		ul {
			margin-top: 0;
		}
	}
</style>
