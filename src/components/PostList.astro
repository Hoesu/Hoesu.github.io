---
import { getCategory, type Post } from '../utils/posts';
import FormattedDate from './FormattedDate.astro';

interface Props {
	posts: Post[];
	/** 카테고리 페이지처럼 이미 카테고리가 정해진 곳에서는 false */
	showCategory?: boolean;
}

const { posts, showCategory = true } = Astro.props;
---

{posts.length === 0 && <p class="muted">아직 글이 없음.</p>}
<ul class="post-list">
	{
		posts.map((post) => {
			const category = showCategory ? getCategory(post) : undefined;
			return (
				<li>
					<a href={`/blog/${post.id}/`}>
						<span class="title">
							{category && <span class="category">{category}</span>}
							{post.data.title}
							{post.data.draft && <em class="muted"> (draft)</em>}
						</span>
						<FormattedDate date={post.data.pubDate} />
					</a>
				</li>
			);
		})
	}
</ul>

<style>
	.post-list {
		list-style: none;
		padding: 0;
		margin: 0 -14px; /* 마우스를 올렸을 때 나오는 배경이 본문 폭보다 살짝 넓게 */
	}
	.post-list a {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 16px;
		padding: 10px 14px;
		border-radius: 10px;
		color: var(--text);
		transition: background 0.15s ease;
	}
	.post-list a:hover {
		background: var(--surface-hover);
		text-decoration: none;
	}
	.post-list a:hover .title {
		color: var(--accent);
	}
	.category {
		margin-right: 0.6em;
		color: var(--muted);
		font-size: 0.85em;
	}
	.category::after {
		content: ' /';
	}
	.post-list time {
		flex-shrink: 0;
		color: var(--muted);
		font-size: 0.875rem;
		font-variant-numeric: tabular-nums;
	}
</style>
