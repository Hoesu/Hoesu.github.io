---
// 홈 화면 앱 아이콘 (둥근 사각형 + 흰색 아이콘 + 선택적 알림 배지)
import { Icon } from 'astro-icon/components';

interface Props {
	href: string;
	label: string;
	icon?: string;
	color: [string, string];
	badge?: number;
	external?: boolean;
}

const { href, label, icon, color, badge, external } = Astro.props;

// 아이콘은 Iconify 이름으로: 'lucide:code' (선 아이콘), 'simple-icons:github' (로고)
// 검색: https://icones.js.org/collection/lucide , https://icones.js.org/collection/simple-icons

const letter = label.trim().charAt(0).toUpperCase();
const badgeText = badge && badge > 99 ? '99+' : badge;
---

<a
	class="app"
	href={href}
	aria-label={badge ? `${label} (글 ${badge}개)` : label}
	{...external ? { target: '_blank', rel: 'noopener' } : {}}
>
	{/* 배지는 .icon 바깥에: 앱 열기 / 닫기 전환은 .icon 상자만 찍어서 상자 밖으로 튀어나온 부분을 자름 */}
	<span class="icon-wrap">
		<span class="icon" style={`--c1:${color[0]};--c2:${color[1]}`}>
			{
				icon ? (
					<Icon name={icon} size={30} aria-hidden="true" />
				) : (
					<span class="letter" aria-hidden="true">{letter}</span>
				)
			}
		</span>
		{badge ? <span class="badge" aria-hidden="true">{badgeText}</span> : null}
	</span>
	<span class="label">{label}</span>
</a>

<style>
	.app {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 6px;
		color: #fff;
		text-decoration: none;
		-webkit-tap-highlight-color: transparent;
	}
	.app:hover {
		text-decoration: none;
	}
	.icon-wrap {
		position: relative;
		transition: transform 0.15s ease;
	}
	.icon {
		display: grid;
		place-items: center;
		width: 60px;
		height: 60px;
		border-radius: 15px;
		color: #fff;
		background: linear-gradient(160deg, var(--c1), var(--c2));
		box-shadow:
			0 4px 12px rgb(0 0 0 / 0.35),
			inset 0 1px 0 rgb(255 255 255 / 0.18);
		transition: filter 0.15s ease;
	}
	.app:hover .icon {
		filter: brightness(1.08);
	}
	/* 누르면 배지와 같이 작아짐 */
	.app:active .icon-wrap {
		transform: scale(0.9);
	}
	.app:active .icon {
		filter: brightness(0.85);
	}
	.app:focus-visible {
		outline: none;
	}
	.app:focus-visible .icon {
		outline: 2px solid #fff;
		outline-offset: 3px;
	}
	.letter {
		font-size: 28px;
		font-weight: 700;
		line-height: 1;
	}
	.badge {
		position: absolute;
		top: -6px;
		right: -6px;
		min-width: 22px;
		height: 22px;
		padding: 0 6px;
		border-radius: 11px;
		background: #ff3b30;
		color: #fff;
		font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif;
		font-size: 12px;
		font-weight: 600;
		line-height: 22px;
		text-align: center;
		font-variant-numeric: tabular-nums;
		box-shadow: 0 1px 3px rgb(0 0 0 / 0.4);
	}
	.label {
		max-width: 76px;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		font-size: 12px;
		line-height: 1.2;
		text-shadow: 0 1px 2px rgb(0 0 0 / 0.5);
	}
</style>
