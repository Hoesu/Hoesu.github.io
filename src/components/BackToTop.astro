---
// 맨 위로 버튼: 글을 한 화면 넘게 내리면 오른쪽 아래에 나타남 (글 페이지에서 씀)
import { Icon } from 'astro-icon/components';
---

<button class="to-top float-btn" type="button" aria-label="맨 위로" hidden>
	<Icon name="lucide:arrow-up" size={20} />
</button>

<script>
	import { prefersReducedMotion } from '../scripts/motion';

	const btn = document.querySelector<HTMLButtonElement>('.to-top');
	if (btn) {
		btn.hidden = false;
		// 보일지 말지가 바뀔 때만 class 를 바꿈 (스크롤마다 건드리지 않음)
		let shown: boolean | null = null;
		const update = () => {
			const next = scrollY > innerHeight;
			if (next === shown) return;
			shown = next;
			btn.classList.toggle('show', next);
		};
		update();
		addEventListener('scroll', update, { passive: true });
		btn.addEventListener('click', () => {
			scrollTo({ top: 0, behavior: prefersReducedMotion() ? 'instant' : 'smooth' });
		});
	}
</script>

<style>
	.to-top {
		position: fixed;
		right: max(16px, env(safe-area-inset-right));
		bottom: max(16px, env(safe-area-inset-bottom));
		z-index: 50;
		opacity: 0;
		transform: translateY(12px) scale(0.9);
		pointer-events: none;
		transition:
			opacity 0.2s,
			transform 0.3s var(--settle),
			border-color 0.2s,
			color 0.2s;
	}
	.to-top.show {
		opacity: 1;
		transform: none;
		pointer-events: auto;
	}
	@media (prefers-reduced-motion: reduce) {
		.to-top {
			transition: opacity 0.2s;
			transform: none;
		}
	}
</style>
