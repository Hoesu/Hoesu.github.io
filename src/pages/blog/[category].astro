---
import MiniIcon from '../../components/MiniIcon.astro';
import PostList from '../../components/PostList.astro';
import Base from '../../layouts/Base.astro';
import { categoryApp } from '../../utils/apps';
import { getPosts, groupByCategory, type Post } from '../../utils/posts';

export async function getStaticPaths() {
	return groupByCategory(await getPosts()).map(([category, posts]) => ({
		params: { category },
		props: { posts },
	}));
}

const { category } = Astro.params;
const { posts } = Astro.props as { posts: Post[] };
const app = categoryApp(category);
---

<Base title={app.label} description={`${app.label} 카테고리 글 목록`}>
	<p class="breadcrumb muted"><a href="/blog/">Categories</a> /</p>
	<header class="page-title">
		<MiniIcon app={app} size={48} />
		<div>
			<h1>{app.label}</h1>
			<p class="muted">글 {posts.length}개</p>
		</div>
	</header>
	<PostList posts={posts} showCategory={false} />
</Base>

<style>
	.page-title {
		display: flex;
		align-items: center;
		gap: 16px;
		margin-bottom: 1.5em;
	}
	.page-title h1 {
		margin: 0;
	}
	.page-title p {
		margin: 0;
		font-size: 0.9rem;
	}
</style>
