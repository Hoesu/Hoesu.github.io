---
import 'katex/dist/katex.min.css'; // 수식 스타일 (수식 글꼴은 수식이 있는 글에서만 내려받음)
import { render } from 'astro:content';
import Comments from '../../components/Comments.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import MiniIcon from '../../components/MiniIcon.astro';
import PostNav from '../../components/PostNav.astro';
import Toc from '../../components/Toc.astro';
import Base from '../../layouts/Base.astro';
import { categoryApp } from '../../utils/apps';
import { getCategory, getNeighbors, getPosts, type Post, tagSlug } from '../../utils/posts';

export async function getStaticPaths() {
	const posts = await getPosts();
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post, ...getNeighbors(post, posts) },
	}));
}

const { post, prev, next } = Astro.props as { post: Post; prev?: Post; next?: Post };
const { title, description, pubDate, updatedDate, tags } = post.data;
const category = getCategory(post);
const { Content, headings } = await render(post);
const app = category ? categoryApp(category) : undefined;
---

<Base title={title} description={description ?? title} type="article" image={`/og/${post.id}.png`}>
	{/* data-pagefind-*: 검색 인덱스 설정. 글 본문만 검색되고, 카테고리 / 태그는 검색 필터가 됨 */}
	<article data-pagefind-body>
		<header class="post-header">
			{
				category && app && (
					<p class="breadcrumb" data-pagefind-ignore>
						<a href={`/blog/${category}/`} data-pagefind-filter={`category:${category}`}>
							<MiniIcon app={app} size={20} />
							{app.label}
						</a>
					</p>
				)
			}
			<h1>{title}</h1>
			<p class="meta muted" data-pagefind-ignore>
				<FormattedDate date={pubDate} />
				{updatedDate && <span> · 수정 <FormattedDate date={updatedDate} /></span>}
			</p>
			{
				tags.length > 0 && (
					<p class="tags" data-pagefind-ignore>
						{tags.map((t) => (
							<a class="chip" href={`/tags/${tagSlug(t)}/`} data-pagefind-filter={`tag:${t}`}>
								#{t}
							</a>
						))}
					</p>
				)
			}
		</header>
		<div data-pagefind-ignore><Toc headings={headings} /></div>
		<Content />
	</article>
	<PostNav prev={prev} next={next} />
	<Comments />
	<p class="back"><a href={category ? `/blog/${category}/` : '/'}>← {app?.label ?? '목록'}으로</a></p>
</Base>

<style>
	.post-header {
		margin-bottom: 2.5em;
	}
	.post-header h1 {
		margin-bottom: 0.3em;
	}
	.meta {
		font-size: 0.9rem;
		margin: 0;
	}
	.breadcrumb a {
		display: inline-flex;
		align-items: center;
		gap: 8px;
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin: 0.9em 0 0;
		font-size: 0.85rem;
	}
	.back {
		margin-top: 2em;
		font-size: 0.95rem;
	}
</style>
