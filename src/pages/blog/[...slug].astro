---
import { render } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';
import Base from '../../layouts/Base.astro';
import { getCategory, getPosts, type Post, tagSlug } from '../../utils/posts';

export async function getStaticPaths() {
	const posts = await getPosts();
	return posts.map((post) => ({ params: { slug: post.id }, props: post }));
}

const post = Astro.props as Post;
const { title, description, pubDate, updatedDate, tags } = post.data;
const category = getCategory(post);
const { Content } = await render(post);
---

<Base title={title} description={description ?? title} type="article">
	<article>
		<header class="post-header">
			{category && <p class="breadcrumb muted"><a href={`/blog/${category}/`}>{category}</a> /</p>}
			<h1>{title}</h1>
			<p class="meta muted">
				<FormattedDate date={pubDate} />
				{updatedDate && <span> · 수정 <FormattedDate date={updatedDate} /></span>}
			</p>
			{
				tags.length > 0 && (
					<p class="tags">
						{tags.map((t) => (
							<a href={`/tags/${tagSlug(t)}/`}>#{t}</a>
						))}
					</p>
				)
			}
		</header>
		<Content />
	</article>
	<p class="back"><a href="/">← 목록으로</a></p>
</Base>

<style>
	.post-header {
		margin-bottom: 2.5em;
	}
	.post-header h1 {
		margin-bottom: 0.3em;
	}
	.meta {
		font-size: 0.9rem;
		margin: 0;
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 4px 12px;
		margin: 0.4em 0 0;
		font-size: 0.9rem;
	}
	.back {
		margin-top: 4em;
		font-size: 0.95rem;
	}
</style>
