---
import { render } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';
import PostNav from '../../components/PostNav.astro';
import Toc from '../../components/Toc.astro';
import Base from '../../layouts/Base.astro';
import { getCategory, getNeighbors, getPosts, type Post, tagSlug } from '../../utils/posts';

export async function getStaticPaths() {
	const posts = await getPosts();
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post, ...getNeighbors(post, posts) },
	}));
}

const { post, prev, next } = Astro.props as { post: Post; prev?: Post; next?: Post };
const { title, description, pubDate, updatedDate, tags } = post.data;
const category = getCategory(post);
const { Content, headings } = await render(post);
---

<Base title={title} description={description ?? title} type="article">
	<article>
		<header class="post-header">
			{category && <p class="breadcrumb muted"><a href={`/blog/${category}/`}>{category}</a> /</p>}
			<h1>{title}</h1>
			<p class="meta muted">
				<FormattedDate date={pubDate} />
				{updatedDate && <span> · 수정 <FormattedDate date={updatedDate} /></span>}
			</p>
			{
				tags.length > 0 && (
					<p class="tags">
						{tags.map((t) => (
							<a href={`/tags/${tagSlug(t)}/`}>#{t}</a>
						))}
					</p>
				)
			}
		</header>
		<Toc headings={headings} />
		<Content />
	</article>
	<PostNav prev={prev} next={next} />
	<p class="back"><a href={category ? `/blog/${category}/` : '/'}>← {category ?? '목록'}으로</a></p>
</Base>

<style>
	.post-header {
		margin-bottom: 2.5em;
	}
	.post-header h1 {
		margin-bottom: 0.3em;
	}
	.meta {
		font-size: 0.9rem;
		margin: 0;
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 4px 12px;
		margin: 0.4em 0 0;
		font-size: 0.9rem;
	}
	.back {
		margin-top: 2em;
		font-size: 0.95rem;
	}
</style>
