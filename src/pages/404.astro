---
// 없는 주소로 들어왔을 때 (GitHub Pages 가 dist/404.html 을 보여줌)
import Base from '../layouts/Base.astro';
import notFound from '../scripts/not-found.inline.js?raw';
import { inlineJs, toJs } from '../utils/inline-js';
import { getPosts } from '../utils/posts';

// 주소가 비슷한 글 추천용 (주소 오타, 바뀐 주소). [주소, 제목] 목록을 페이지에 넣어둠 (글 60개 기준 약 4KB)
const posts = (await getPosts()).map((p) => [`/blog/${p.id}/`, p.data.title]);
---

<Base title="404" description="페이지를 찾을 수 없습니다">
	<section class="not-found">
		<h1>페이지를 찾을 수 없습니다</h1>
		{/* 요청한 주소 + 비슷한 글 (아래 스크립트가 채움) */}
		<dl class="info" hidden>
			<div><dt>요청한 주소</dt><dd><code class="req"></code></dd></div>
			<div class="suggest" hidden><dt>비슷한 글</dt><dd><a></a></dd></div>
		</dl>
	</section>
</Base>

<script is:inline set:html={`var posts = ${toJs(posts)};
` + inlineJs(notFound)}></script>

<style>
	.not-found {
		display: flex;
		flex-direction: column;
		align-items: center;
		padding: 56px 0 24px;
		text-align: center;
		word-break: keep-all; /* 한국어는 단어 단위로 줄바꿈 */
	}
	h1 {
		margin: 0;
	}
	/* 요청한 주소 / 비슷한 글: 이름표 | 값 두 칸 표 */
	.info {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		gap: 6px 16px;
		max-width: 100%;
		margin: 20px 0 0;
		padding: 12px 16px;
		border: 1px solid var(--border);
		border-radius: 10px;
		background: var(--surface);
		font-size: 0.9rem;
		text-align: left;
	}
	.info > div:not([hidden]) {
		display: contents;
	}
	.info dt {
		color: var(--muted);
	}
	.info dd {
		margin: 0;
		overflow-wrap: anywhere;
	}
	.info code {
		padding: 0;
		background: none;
		color: var(--text);
		font-size: inherit;
	}
	.info a {
		font-weight: 600;
	}
</style>
