---
import AppIcon from '../components/AppIcon.astro';
import { CATEGORY_APPS, GITHUB_URL, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import Base from '../layouts/Base.astro';
import { getPosts, groupByCategory } from '../utils/posts';

const categories = groupByCategory(await getPosts());

// 설정이 없는 카테고리는 이름으로 색을 정함 (항상 같은 색)
function autoColor(name: string): [string, string] {
	let h = 0;
	for (const ch of name) h = (h * 31 + ch.codePointAt(0)!) % 360;
	return [`hsl(${h} 70% 58%)`, `hsl(${(h + 30) % 360} 65% 45%)`];
}

const apps = categories.map(([name, posts]) => {
	const cfg = CATEGORY_APPS[name] ?? {};
	return {
		href: `/blog/${name}/`,
		label: cfg.label ?? name,
		icon: cfg.icon,
		color: cfg.color ?? autoColor(name),
		badge: posts.length,
	};
});

const dock = [
	// 아이콘 색: 팔레트(시안 / 오렌지 / 핑크 / 남색) 기준. 흰 아이콘이 잘 보이도록 아래쪽은 한 톤 어둡게
	{ href: '/search/', label: 'Search', icon: 'search', color: ['#00d4f0', '#0a6fb0'] as [string, string] },
	{ href: '/tags/', label: 'Tags', icon: 'hash', color: ['#ffb86b', '#f07a3a'] as [string, string] },
	{ href: '/about/', label: 'About', icon: 'user', color: ['#ff5ca8', '#c4337f'] as [string, string] },
	{ href: GITHUB_URL, label: 'GitHub', icon: 'github', color: ['#2a3070', '#151a3f'] as [string, string], external: true },
];
---

<Base title={SITE_TITLE} description={SITE_DESCRIPTION} home>
	<h1 class="sr-only">{SITE_TITLE}</h1>
	<div class="phone">
		<div class="screen">
			<!-- 상태 표시줄 (데스크톱 폰 틀에서만 보임) -->
			<div class="status" aria-hidden="true">
				<span class="time" data-clock>9:41</span>
				<span class="island"></span>
				<span class="indicators">
					<svg viewBox="0 0 18 12" class="signal"
						><rect x="0" y="8" width="3" height="4" rx="1"></rect><rect x="5" y="5.5" width="3" height="6.5" rx="1"
						></rect><rect x="10" y="3" width="3" height="9" rx="1"></rect><rect x="15" y="0" width="3" height="12" rx="1"
						></rect></svg
					>
					<svg viewBox="0 0 27 13" class="battery"
						><rect x="0.5" y="0.5" width="23" height="12" rx="3.5" fill="none" stroke="currentColor" opacity="0.45"
						></rect><rect x="2" y="2" width="17" height="9" rx="2"></rect><rect x="24.5" y="4" width="2" height="5" rx="1"
						opacity="0.45"></rect></svg
					>
				</span>
			</div>

			<nav class="grid" aria-label="카테고리">
				{apps.map((app) => <AppIcon {...app} />)}
			</nav>

			<div class="dots" aria-hidden="true"><span></span></div>

			<nav class="dock" id="home-dock" aria-label="메뉴">
				{dock.map((app) => <AppIcon {...app} />)}
			</nav>

			<div class="home-bar" aria-hidden="true"></div>
		</div>
	</div></Base>

<script>
	import { setupAppAnimations } from '../scripts/app-animation';
	setupAppAnimations();
</script>

<script>
	// 상태 표시줄 시계를 현재 시각으로
	const el = document.querySelector<HTMLElement>('[data-clock]');
	if (el) {
		const tick = () => {
			const d = new Date();
			el.textContent = `${d.getHours()}:${String(d.getMinutes()).padStart(2, '0')}`;
		};
		tick();
		setInterval(tick, 15_000);
	}
</script>

<style>
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
	}

	/* ---------- 폰 틀 (데스크톱) ---------- */
	.phone {
		width: 390px;
		max-width: 100%;
		margin: 48px auto 0;
		padding: 12px;
		border-radius: 58px;
		background: #141838;
		box-shadow:
			0 0 0 2px #2a3070,
			0 30px 80px rgb(0 0 0 / 0.55),
			0 0 120px rgb(188 108 255 / 0.18); /* 보랏빛 은은한 광 */
	}
	.screen {
		position: relative;
		display: flex;
		flex-direction: column;
		/* 화면 높이가 낮은 노트북에서도 폰 전체가 보이게 */
		height: clamp(600px, calc(100svh - 120px), 780px);
		padding: 14px 22px 10px;
		border-radius: 46px;
		overflow: hidden;
		color: #fff;
		/* 배경화면: 남색 바탕에 핑크(왼쪽 위) / 보라(오른쪽 아래) / 시안(가운데 오른쪽) 빛 */
		background:
			radial-gradient(110% 70% at 10% 0%, rgb(255 92 168 / 0.42), transparent 60%),
			radial-gradient(110% 80% at 100% 100%, rgb(188 108 255 / 0.45), transparent 58%),
			radial-gradient(60% 40% at 95% 45%, rgb(0 240 255 / 0.16), transparent 70%),
			linear-gradient(180deg, #1a1446, #0b0f2b);
	}

	/* ---------- 상태 표시줄 ---------- */
	.status {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		height: 40px;
		margin-bottom: 26px;
		font-size: 15px;
		font-weight: 600;
		font-variant-numeric: tabular-nums;
	}
	.time {
		padding-left: 12px;
	}
	.island {
		width: 112px;
		height: 32px;
		border-radius: 20px;
		background: #000;
	}
	.indicators {
		display: flex;
		justify-content: flex-end;
		align-items: center;
		gap: 6px;
		padding-right: 8px;
	}
	.indicators svg {
		height: 12px;
		fill: currentColor;
	}

	/* ---------- 앱 격자 ---------- */
	.grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		row-gap: 26px;
		justify-items: center;
		align-content: start;
		flex: 1;
	}

	.dots {
		display: flex;
		justify-content: center;
		margin: 12px 0;
	}
	.dots span {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: rgb(255 255 255 / 0.9);
	}

	/* ---------- 독 ---------- */
	.dock {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		justify-items: center;
		padding: 16px 8px 12px;
		border-radius: 32px;
		background: rgb(255 255 255 / 0.12);
		backdrop-filter: blur(20px);
		-webkit-backdrop-filter: blur(20px);
	}
	/* 독 아이콘은 이름표 없이 (아이폰처럼) */
	.dock :global(.label) {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
	}

	.home-bar {
		width: 134px;
		height: 5px;
		margin: 14px auto 2px;
		border-radius: 3px;
		background: rgb(255 255 255 / 0.85);
	}

	/* ---------- 모바일: 틀 없이 화면 전체가 홈 화면 ---------- */
	@media (max-width: 480px) {
		.phone {
			width: auto;
			max-width: none;
			margin: 0 -20px; /* body 좌우 여백까지 꽉 채움 */
			padding: 0;
			border-radius: 0;
			box-shadow: none;
			background: none;
		}
		.screen {
			height: auto;
			min-height: 100svh;
			padding: 56px 16px max(12px, env(safe-area-inset-bottom));
			border-radius: 0;
		}
		/* 진짜 폰에는 상태 표시줄, 홈 바가 이미 있으니 가짜는 숨김 */
		.status,
		.home-bar {
			display: none;
		}
	}
</style>
