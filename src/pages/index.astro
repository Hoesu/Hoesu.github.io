---
import AppIcon from '../components/AppIcon.astro';
import { EMAIL, GITHUB_URL, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import Base from '../layouts/Base.astro';
import { categoryApp } from '../utils/apps';
import { getPosts, groupByCategory } from '../utils/posts';

const categories = groupByCategory(await getPosts());

const apps = categories.map(([name, posts]) => ({
	href: `/blog/${name}/`,
	...categoryApp(name),
	badge: posts.length,
}));

// 바깥 링크 앱 (새 탭으로 열림). 격자 순서는 항상 [카테고리들 → 바깥 링크들]
const links = [
	{ href: GITHUB_URL, label: 'GitHub', icon: 'simple-icons:github', color: ['#2a3070', '#151a3f'] as [string, string], external: true },
	// 메일 앱(새 메일 쓰기)이 열림. 새 탭은 필요 없어서 external 안 씀
	{ href: `mailto:${EMAIL}`, label: 'Gmail', icon: 'simple-icons:gmail', color: ['#ff6b5e', '#d03a2f'] as [string, string] },
];

const dock = [
	// 아이콘 색: 팔레트(남보라 / 오렌지 / 시안 / 핑크) 기준. 흰 아이콘이 잘 보이도록 아래쪽은 한 톤 어둡게
	{ href: '/blog/', label: 'Categories', icon: 'lucide:list', color: ['#8b7bff', '#4b3fc4'] as [string, string] },
	{ href: '/tags/', label: 'Tags', icon: 'lucide:hash', color: ['#ffb86b', '#f07a3a'] as [string, string] },
	{ href: '/search/', label: 'Search', icon: 'lucide:search', color: ['#00d4f0', '#0a6fb0'] as [string, string] },
	{ href: '/about/', label: 'About', icon: 'lucide:user', color: ['#ff5ca8', '#c4337f'] as [string, string] },
];
---

<Base title={SITE_TITLE} description={SITE_DESCRIPTION} home>
	<h1 class="sr-only">{SITE_TITLE}</h1>
	<div class="screen">
		<nav class="grid" aria-label="카테고리">
			{[...apps, ...links].map((app) => <AppIcon {...app} />)}
		</nav>

		<div class="dots" aria-hidden="true"><span></span></div>

		<nav class="dock" id="home-dock" aria-label="메뉴">
			{dock.map((app) => <AppIcon {...app} />)}
		</nav>
	</div>
</Base>

<script>
	import { setupAppAnimations } from '../scripts/app-animation';
	setupAppAnimations();
</script>

<style>
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
	}

	/* ---------- 홈 화면: 화면 전체를 배경화면으로 ---------- */
	.screen {
		position: relative;
		display: flex;
		flex-direction: column;
		min-height: 100svh;
		padding: 72px 40px max(28px, env(safe-area-inset-bottom));
		box-sizing: border-box;
		color: #fff;
		/* 배경화면: 남색 바탕에 핑크(왼쪽 위) / 보라(오른쪽 아래) / 시안(가운데 오른쪽) 빛 */
		background:
			radial-gradient(70% 70% at 10% 0%, rgb(255 92 168 / 0.38), transparent 60%),
			radial-gradient(70% 80% at 100% 100%, rgb(188 108 255 / 0.42), transparent 58%),
			radial-gradient(40% 40% at 95% 45%, rgb(0 240 255 / 0.14), transparent 70%),
			linear-gradient(180deg, #1a1446, #0b0f2b);
	}

	/* ---------- 앱 격자 (왼쪽 위부터 채움) ---------- */
	.grid {
		display: flex;
		flex-wrap: wrap;
		justify-content: flex-start;
		align-content: flex-start;
		gap: 32px 36px;
		flex: 1;
	}

	.dots {
		display: flex;
		justify-content: center;
		margin: 12px 0;
	}
	.dots span {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: rgb(255 255 255 / 0.9);
	}

	/* ---------- 독 ---------- */
	.dock {
		display: grid;
		grid-auto-flow: column;
		grid-auto-columns: 84px;
		justify-items: center;
		width: fit-content;
		margin: 0 auto;
		padding: 16px 12px 12px;
		/* 리퀴드 글래스 느낌 (애플 iOS 26 스타일 흉내)
		   - 뒤가 흐리게 비치되 색은 더 선명하게 (saturate), 살짝 밝게
		   - 위쪽 가장자리가 빛을 받아 반짝임 (inset 그림자), 안쪽에 은은한 빛, 아래에 그림자로 떠 있는 느낌
		   - 테두리: 왼쪽 위 / 오른쪽 아래만 밝은 얇은 띠 (::before)
		   - 표면 광택: 위쪽에 부드러운 반사광 (::after) */
		position: relative;
		isolation: isolate;
		border-radius: 32px;
		background: linear-gradient(180deg, rgb(255 255 255 / 0.16), rgb(255 255 255 / 0.05));
		backdrop-filter: blur(16px) saturate(180%) brightness(1.08);
		-webkit-backdrop-filter: blur(16px) saturate(180%) brightness(1.08);
		box-shadow:
			inset 0 1px 0.5px rgb(255 255 255 / 0.55),
			inset 0 -1px 0.5px rgb(255 255 255 / 0.12),
			inset 0 0 24px rgb(255 255 255 / 0.06),
			0 12px 32px rgb(0 0 0 / 0.35);
	}
	.dock::before,
	.dock::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		border-radius: inherit;
		pointer-events: none;
	}
	/* 가장자리 빛 띠: 테두리 1px 만 남기고 가운데는 비움 (mask) */
	.dock::before {
		padding: 1px;
		background: linear-gradient(
			135deg,
			rgb(255 255 255 / 0.7),
			rgb(255 255 255 / 0.12) 35%,
			rgb(255 255 255 / 0.05) 60%,
			rgb(255 255 255 / 0.4)
		);
		mask:
			linear-gradient(#000 0 0) content-box exclude,
			linear-gradient(#000 0 0);
	}
	/* 표면 광택: 위쪽 절반에 위에서 내려오는 반사광 */
	.dock::after {
		background: radial-gradient(120% 70% at 50% -20%, rgb(255 255 255 / 0.18), transparent 60%);
	}
	/* 독 아이콘은 이름표 없이 (아이폰처럼) */
	.dock :global(.label) {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
	}

	/* ---------- 모바일: 아이폰처럼 4칸 격자 ---------- */
	@media (max-width: 480px) {
		.screen {
			padding: 56px 16px max(12px, env(safe-area-inset-bottom));
		}
		.grid {
			display: grid;
			grid-template-columns: repeat(4, 1fr);
			gap: 26px 0;
			justify-items: center;
			align-content: start;
		}
		.dock {
			grid-auto-columns: 1fr;
			width: auto;
			margin: 0;
			padding: 16px 8px 12px;
		}
	}
</style>
