---
import { getImage } from 'astro:assets';
import wallpaper from '../assets/wallpaper.jpg';
import AppIcon from '../components/AppIcon.astro';
import GrassWidget from '../components/widgets/GrassWidget.astro';
import RandomWidget from '../components/widgets/RandomWidget.astro';
import RecentWidget from '../components/widgets/RecentWidget.astro';
import { EMAIL, GITHUB_URL, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import Base from '../layouts/Base.astro';
import { categoryApp } from '../utils/apps';
import { getPosts, groupByCategory } from '../utils/posts';

const posts = await getPosts();
const categories = groupByCategory(posts);

// 배경화면 사진 (src/assets/wallpaper.jpg). 빌드할 때 WebP 두 가지 크기로 줄임:
// 보통 화면은 1920px, 폰 세로 화면(높이에 맞춰 가운데를 크게 보여줌)과 큰 모니터는 2560px
const [wpSmall, wpLarge] = await Promise.all([
	getImage({ src: wallpaper, width: 1920, format: 'webp', quality: 75, layout: 'none' }),
	getImage({ src: wallpaper, width: 2560, format: 'webp', quality: 75, layout: 'none' }),
]);

const apps = categories.map(([name, posts]) => ({
	href: `/blog/${name}/`,
	...categoryApp(name),
	badge: posts.length,
}));

// 바깥 링크 앱 (새 탭으로 열림). 격자 순서는 항상 [카테고리들 → 바깥 링크들]
const links = [
	{ href: GITHUB_URL, label: 'GitHub', icon: 'simple-icons:github', color: ['#2a3070', '#151a3f'] as [string, string], external: true },
	// 메일 앱(새 메일 쓰기)이 열림. 새 탭은 필요 없어서 external 안 씀
	{ href: `mailto:${EMAIL}`, label: 'Gmail', icon: 'simple-icons:gmail', color: ['#ff6b5e', '#d03a2f'] as [string, string] },
];

const dock = [
	// 아이콘 색: 팔레트(남보라 / 오렌지 / 시안 / 핑크) 기준. 흰 아이콘이 잘 보이도록 아래쪽은 한 톤 어둡게
	{ href: '/blog/', label: 'Categories', icon: 'lucide:list', color: ['#8b7bff', '#4b3fc4'] as [string, string] },
	{ href: '/tags/', label: 'Tags', icon: 'lucide:hash', color: ['#ffb86b', '#f07a3a'] as [string, string] },
	{ href: '/search/', label: 'Search', icon: 'lucide:search', color: ['#00d4f0', '#0a6fb0'] as [string, string] },
	{ href: '/about/', label: 'About', icon: 'lucide:user', color: ['#ff5ca8', '#c4337f'] as [string, string] },
];
---

<Base title={SITE_TITLE} description={SITE_DESCRIPTION} home>
	<h1 class="sr-only">{SITE_TITLE}</h1>
	<div class="screen" style={`--wp-small: url(${wpSmall.src}); --wp-large: url(${wpLarge.src})`}>
		<div class="home">
			<nav class="grid" aria-label="카테고리">
				{[...apps, ...links].map((app) => <AppIcon {...app} />)}
			</nav>
			{/* 위젯: 잔디(4×2) 아래에 최근 글(2×2) + 랜덤 글(2×2). 넓은 화면은 오른쪽에, 폰은 아이폰처럼 격자 맨 위에 */}
			<div class="widgets">
				<GrassWidget posts={posts} />
				{posts[0] && <RecentWidget post={posts[0]} />}
				<RandomWidget posts={posts} exclude={posts[0]} />
			</div>
		</div>

		<div class="dots" aria-hidden="true"><span></span></div>

		<nav class="dock" id="home-dock" aria-label="메뉴">
			{dock.map((app) => <AppIcon {...app} />)}
		</nav>
	</div>
	{/* 독 굴절 효과용 SVG 필터 (src/scripts/dock-refraction.ts 가 지도를 채움). 화면에는 안 보임 */}
	<svg class="filters" width="0" height="0" aria-hidden="true">
		<filter id="dock-refract" x="0" y="0" width="100%" height="100%" color-interpolation-filters="sRGB">
			<feImage id="dock-refract-map" x="0" y="0" preserveAspectRatio="none" result="map"></feImage>
			<feDisplacementMap id="dock-refract-displace" in="SourceGraphic" in2="map" scale="0" xChannelSelector="R" yChannelSelector="G"></feDisplacementMap>
		</filter>
	</svg>
</Base>

<script>
	import { setupAppAnimations } from '../scripts/app-animation';
	import { setupDockRefraction } from '../scripts/dock-refraction';
	setupAppAnimations();
	setupDockRefraction();
</script>

<style>
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
	}

	/* ---------- 홈 화면: 화면 전체를 배경화면으로 ---------- */
	.screen {
		position: relative;
		display: flex;
		flex-direction: column;
		min-height: 100svh;
		padding: 72px 40px max(28px, env(safe-area-inset-bottom));
		box-sizing: border-box;
		color: #fff;
		/* 배경화면: 사진(--wp, 위 frontmatter 에서 만듦). 화면에 맞게 가운데 기준으로 잘림.
		   위에 검은 막을 살짝 덮어서 어둡게 (앱 이름 흰 글씨가 잘 보이게). 아이콘이 있는 위쪽을 조금 더 어둡게 */
		--wp: var(--wp-small);
		background:
			linear-gradient(rgb(0 0 0 / 0.4), rgb(0 0 0 / 0.25) 35%, rgb(0 0 0 / 0.25)),
			var(--wp) center / cover no-repeat,
			#000;
	}
	/* 폰 세로 화면은 사진을 높이에 맞춰 키우고, 큰 모니터는 넓으니 큰 사진 */
	@media (orientation: portrait), (min-width: 1921px) {
		.screen {
			--wp: var(--wp-large);
		}
	}

	/* ---------- 앱 격자 (왼쪽 위부터 채움) ---------- */
	/* 앱 격자(왼쪽) + 위젯(오른쪽 세로) */
	.home {
		display: flex;
		align-items: flex-start;
		gap: 36px;
		flex: 1;
	}
	.grid {
		display: flex;
		flex-wrap: wrap;
		justify-content: flex-start;
		align-content: flex-start;
		gap: 32px 36px;
		align-items: flex-start;
		flex: 1;
	}
	.widgets {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 20px;
		width: 340px;
	}
	.widgets :global(.grass) {
		grid-column: 1 / -1;
	}

	/* ---------- 위젯 (src/components/widgets/): 독과 같은 유리 느낌 (아래 .dock 규칙을 같이 씀) ---------- */
	.widgets :global(.widget) {
		box-sizing: border-box;
		height: 160px;
		padding: 14px 16px;
		border-radius: 22px;
	}

	.dots {
		display: flex;
		justify-content: center;
		margin: 12px 0;
	}
	.dots span {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: rgb(255 255 255 / 0.9);
	}

	/* ---------- 독 ---------- */
	.dock {
		display: grid;
		grid-auto-flow: column;
		grid-auto-columns: 84px;
		justify-items: center;
		width: fit-content;
		margin: 0 auto;
		padding: 16px 12px 12px;
		/* 리퀴드 글래스 느낌 (애플 iOS 26 스타일 흉내)
		   - 뒤가 흐리게 비치되 색은 더 선명하게 (saturate), 살짝 밝게
		   - 안쪽에 은은한 빛, 아래에 그림자로 떠 있는 느낌
		   - 테두리: 빛을 받는 왼쪽 위(10~11시) / 오른쪽 아래(4~5시)만 밝고, 1시 / 7시 방향은 사라짐 (::before)
		   - 표면 광택: 위쪽에 부드러운 반사광 (::after) */
		border-radius: 32px;
	}
	/* 유리 느낌: 독 + 위젯 */
	.dock,
	.widgets :global(.widget) {
		position: relative;
		isolation: isolate;
		background: linear-gradient(180deg, rgb(255 255 255 / 0.16), rgb(255 255 255 / 0.05));
		backdrop-filter: blur(16px) saturate(180%) brightness(1.08);
		-webkit-backdrop-filter: blur(16px) saturate(180%) brightness(1.08);
		box-shadow:
			inset 0 0 24px rgb(255 255 255 / 0.06),
			0 12px 32px rgb(0 0 0 / 0.35);
	}
	/* 굴절 효과 (Chrome 계열만, dock-refraction.ts 가 refract 를 붙임):
	   가장자리에서 배경을 휜 다음 살짝만 흐리게 (많이 흐리면 휜 게 안 보임) */
	.dock.refract {
		backdrop-filter: url(#dock-refract) blur(2px) saturate(170%) brightness(1.08);
	}
	.filters {
		position: absolute;
		width: 0;
		height: 0;
		overflow: hidden;
	}
	.dock::before,
	.dock::after,
	.widgets :global(.widget)::before,
	.widgets :global(.widget)::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		border-radius: inherit;
		pointer-events: none;
	}
	/* 가장자리 빛 띠: 테두리 2px 만 남기고 가운데는 비움 (mask).
	   굵기는 정수로: 1.5px 처럼 소수면 위 / 왼쪽은 2px, 아래 / 오른쪽은 1px 로 반올림돼서 굵기가 달라짐.
	   'to bottom right' 는 독이 길쭉해도 오른쪽 위 / 왼쪽 아래 모서리가 정확히 50% 지점이 되는 방향이라,
	   50% 근처를 투명하게 하면 그 두 모서리(1시 / 7시)에서 테두리가 사라짐 */
	.dock::before,
	.widgets :global(.widget)::before {
		padding: 2px;
		background: linear-gradient(
			to bottom right,
			rgb(255 255 255 / 0.85),
			rgb(255 255 255 / 0.35) 20%,
			transparent 40% 60%,
			rgb(255 255 255 / 0.3) 80%,
			rgb(255 255 255 / 0.7)
		);
		mask:
			linear-gradient(#000 0 0) content-box exclude,
			linear-gradient(#000 0 0);
	}
	/* 표면 광택: 위쪽 절반에 위에서 내려오는 반사광 */
	.dock::after,
	.widgets :global(.widget)::after {
		background: radial-gradient(120% 70% at 50% -20%, rgb(255 255 255 / 0.18), transparent 60%);
	}
	/* 독 아이콘은 이름표 없이 (아이폰처럼) */
	.dock :global(.label) {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
	}

	/* ---------- 모바일: 아이폰처럼 4칸 격자 ---------- */
	@media (max-width: 480px) {
		.screen {
			padding: 56px 16px max(12px, env(safe-area-inset-bottom));
		}
		/* 격자 하나로 합침: .grid / .widgets 상자를 풀어서(display: contents) 위젯과 앱 아이콘이 같은 격자에 들어감 */
		.home {
			display: grid;
			grid-template-columns: repeat(4, 1fr);
			grid-auto-flow: row dense; /* 최근 글 위젯 옆 빈칸을 앱 아이콘이 채움 */
			gap: 26px 0;
			justify-items: center;
			align-content: start;
		}
		.grid,
		.widgets {
			display: contents;
		}
		.widgets :global(.widget) {
			order: -1; /* 위젯이 앱 아이콘보다 먼저 */
		}
		/* 위젯: 아이폰처럼 잔디는 4칸 × 2줄, 최근 글은 2칸 × 2줄 */
		.widgets :global(.widget) {
			justify-self: stretch;
			align-self: stretch; /* 나란히 놓인 최근 글 / 랜덤 글 높이를 맞춤 */
			width: auto;
			height: auto;
			margin: 0 8px;
			grid-row: span 2;
		}
		.widgets :global(.grass) {
			width: auto;
			grid-column: 1 / -1;
		}
		.widgets :global(.recent),
		.widgets :global(.random) {
			width: auto;
			grid-column: span 2;
		}
		.dock {
			grid-auto-columns: 1fr;
			width: auto;
			margin: 0;
			padding: 16px 8px 12px;
		}
	}
</style>
