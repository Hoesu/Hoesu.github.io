---
import PostList from '../../components/PostList.astro';
import Base from '../../layouts/Base.astro';
import { getPosts, groupByTag, type Post } from '../../utils/posts';

export async function getStaticPaths() {
	return groupByTag(await getPosts()).map(({ slug, name, posts }) => ({
		params: { tag: slug },
		props: { name, posts },
	}));
}

const { name, posts } = Astro.props as { name: string; posts: Post[] };
---

<Base title={`#${name}`} description={`#${name} 태그 글 목록`}>
	<p class="breadcrumb muted"><a href="/tags/">Tags</a> /</p>
	<h1>#{name}</h1>
	<PostList posts={posts} />
</Base>
