{
  "name": "hoesu-blog",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist --exclude-selectors \".expressive-code .copy, .expressive-code .gutter\"",
    "preview": "astro preview",
    "astro": "astro",
    "clean": "node -e \"for (const p of ['.astro/data-store.json', 'node_modules/.astro']) require('fs').rmSync(p, { recursive: true, force: true })\""
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.6",
    "@astrojs/mdx": "^8.1.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@expressive-code/plugin-collapsible-sections": "^0.44.3",
    "@expressive-code/plugin-line-numbers": "^0.44.3",
    "@iconify-json/lucide": "^1.2.151",
    "@iconify-json/simple-icons": "^1.2.101",
    "astro": "^7.4.5",
    "astro-expressive-code": "^0.44.3",
    "astro-icon": "^1.2.0",
    "katex": "^0.19.1",
    "satteri": "^0.10.5",
    "sharp": "^0.35.0"
  },
  "devDependencies": {
    "pagefind": "^1.5.2"
  }
}
